# Copy this file to .env and put your real password in it.
# .env is in .gitignore, so the password never gets committed.
DATABASE_URL=postgres://USER:YOUR_PASSWORD@localhost:5432/reading_list

# Local alternative without a password: connect through the Unix socket
# (peer authentication uses your Linux username).
# DATABASE_URL=postgres:///reading_list?host=/var/run/postgresql

# PORT=3000
