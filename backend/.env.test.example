# Settings for the e2e tests (npm run test:e2e). Copy this file to .env.test.
# The tests DELETE ALL BOOKS before every test, so this must be a separate
# database, never the one in .env. vitest.config.e2e.ts refuses to run unless
# the database name ends with _test. The tests create the tables themselves
# (prisma migrate deploy).
DATABASE_URL=postgresql://USER:YOUR_PASSWORD@localhost:5432/reading_list_test

# Without a password, through the Unix socket (see .env.example):
# DATABASE_URL=postgresql://USER@localhost/reading_list_test?host=/var/run/postgresql
