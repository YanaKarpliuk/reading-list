# Copy this file to .env and put your real password in it.
# .env is in .gitignore, so the password never gets committed.
# Both the app and the Prisma CLI (prisma migrate, prisma studio) read it.
DATABASE_URL=postgresql://USER:YOUR_PASSWORD@localhost:5432/reading_list

# Local alternative without a password: connect through the Unix socket
# (peer authentication uses your Linux username). The Prisma CLI needs the
# user and "localhost" in the URL, even though the socket path is what's used.
# DATABASE_URL=postgresql://USER@localhost/reading_list?host=/var/run/postgresql

# PORT=3000
